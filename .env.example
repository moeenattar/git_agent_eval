# Gemini Developer API authentication (GEMINI_API_KEY is also accepted)
GOOGLE_API_KEY=
GROQ_API_KEY=

# Runtime configuration
TRIAGE_MODEL=gemini-3.5-flash-lite
TRIAGE_PROMPT_PATH=prompts/triage_v2.txt

# Optional local Phoenix tracing
TRIAGE_ENABLE_PHOENIX=false
PHOENIX_PROJECT_NAME=github-triage
PHOENIX_BASE_URL=http://localhost:6006
TRIAGE_PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
